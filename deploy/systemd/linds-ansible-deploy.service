[Unit]
Description=Apply LINDS-Ansible main to the hosts (deploy/README.md)

[Service]
Type=oneshot
ExecStart=%h/.local/state/linds-ansible-deploy/repo/deploy/linds-ansible-deploy
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=linds-ansible-deploy
# A change to windows.yml takes three runs of about 15 minutes each.
TimeoutStartSec=4h
# Ansible needs well under this. The limit keeps an OOM kill inside this unit.
MemoryMax=3G
Nice=5
