{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // Renovate is not run from this repository. One workflow in
  // LINDS-Kubernetes (.github/workflows/renovate.yaml) runs it for
  // LINDS-Kubernetes, LINDS-Terraform and LINDS-Ansible; this file is only
  // the configuration it reads here. The label is the same in all three, so
  // one search lists every open update:
  //   https://github.com/pulls?q=is%3Aopen+is%3Apr+user%3AJayden-Lind+label%3Arenovate
  //
  // What it tracks here is requirements.yml: the Galaxy roles and
  // collections. It also tracks requirements-windows.txt, the pinned Python
  // environment of the Windows playbooks. The deploy (deploy/README.md) uses
  // the versions that these two files pin, so merging a PR runs the checks of
  // every playbook in deploy/playbooks with the new version. For a run by
  // hand, run `make update-requirements` and rebuild .venv after a merge.
  //
  // Not tracked:
  // requirements.txt, which names its packages without a version (Renovate
  // skips those), and anything installed with apt on the hosts themselves.
  labels: ["renovate"],

  // A homelab doesn't need 25 PRs in the first hour.
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
}
