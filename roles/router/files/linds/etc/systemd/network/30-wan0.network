# Managed by LINDS-Ansible: roles/router/files/linds/etc/systemd/network/30-wan0.network. The WAN, and the only
# one: there is no failover daemon here (router_failover is off), so the
# default route is the one in the DHCP lease and networkd installs it.
#
# linds-vyos-01 routed by a static default with no next hop
# (`protocols static route 0.0.0.0/0 interface eth1`): it asked ARP for every
# internet address and Telstra's gateway answered for all of them (579 and
# then 764 neighbour entries an hour apart on 2026-10-13, every one with the
# same MAC). The lease does carry a router
# (101.186.255.254 on 2026-10-13, inside the /17), so this uses it. If the
# WAN has a lease and nothing gets out, the VyOS way is one command:
#   ip route replace default dev wan0
#
# KeepConfiguration=dhcp keeps the address through a renewal or a networkd
# restart instead of tearing it down first.
[Match]
Name=wan0

[Link]
RequiredForOnline=no

[Network]
# Both families. With WithoutRA=solicit networkd ignores the RA's request to
# start DHCPv6 (it assumes the client already started at link setup), and
# that start only happens when DHCP= includes ipv6.
DHCP=yes
KeepConfiguration=dhcp
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
LLDP=no
EmitLLDP=no

[DHCPv4]
UseGateway=yes
UseDNS=no
UseNTP=no
UseHostname=no
UseDomains=no
SendHostname=no
SendRelease=no
ClientIdentifier=mac

[IPv6AcceptRA]
UseGateway=yes
UseDNS=no
UseDomains=no
DHCPv6Client=always

[DHCPv6]
UseAddress=yes
UseDNS=no
UseNTP=no
WithoutRA=solicit
PrefixDelegationHint=::/56
