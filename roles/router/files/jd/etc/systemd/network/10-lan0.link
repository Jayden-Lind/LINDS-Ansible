# Managed by LINDS-Ansible: roles/router/files/etc/systemd/network/10-lan0.link. lan0: named by MAC so
# PCI slot order never matters. Type=ether keeps the VLAN sub-interfaces,
# which inherit this MAC, from matching.
[Match]
MACAddress=bc:24:11:01:11:01
Type=ether

[Link]
Name=lan0
GenericReceiveOffload=yes
GenericSegmentationOffload=yes
TCPSegmentationOffload=yes
# Hardware GRO lets the host give lan0 TCP packets of up to 64 KB. If it is
# off, the host cuts each packet into 1500-byte frames, and one flow between
# two VLANs gets about 330 MB/s instead of 1.5 GB/s. The kernel turns LRO off
# on a router, but it keeps this offload: virtio-net reports it as rx-gro-hw.
GenericReceiveOffloadHardware=yes
