# Managed by LINDS-Ansible: roles/router/files/etc/systemd/network/30-wan0.network. The WAN.
#
# The only WAN since 2026-10-24 (router_failover is off: the cellular backup
# has no service). The default route is the one in the DHCP lease
# (1.159.127.254 on 2026-10-24) and networkd installs it, as at LINDS. The
# lease supplies no DNS and no NTP that are used. KeepConfiguration=dhcp keeps
# the address through a renewal or a networkd restart instead of tearing it
# down first, the "small outage on every renew" VyOS's dhclient produced.
#
# With failover the default route was wan-failover's (UseGateway=no), and
# table 1001 plus an oif rule carried the health check's pings (a gateway
# written here, 121.221.64.1, that the old modem proxy-ARPed for). Revert the
# PR that turned failover off to get both back.
[Match]
Name=wan0

[Link]
RequiredForOnline=no

[Network]
# Both families. With WithoutRA=solicit networkd ignores the RA's request to
# start DHCPv6 (it assumes the client already started at link setup), and
# that start only happens when DHCP= includes ipv6. DHCP=ipv4 here left the
# client created but never running: RA default route, no lease, no PD.
DHCP=yes
KeepConfiguration=dhcp
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
LLDP=no
EmitLLDP=no

[DHCPv4]
UseGateway=yes
UseDNS=no
UseNTP=no
UseHostname=no
UseDomains=no
SendHostname=no
SendRelease=no
ClientIdentifier=mac

[IPv6AcceptRA]
UseGateway=yes
UseDNS=no
UseDomains=no
DHCPv6Client=always

[DHCPv6]
UseAddress=yes
UseDNS=no
UseNTP=no
WithoutRA=solicit
PrefixDelegationHint=::/56

