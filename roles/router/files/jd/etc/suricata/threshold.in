# Managed by LINDS-Ansible: roles/router/files/jd/etc/suricata/threshold.in.
# Alert suppressions for jd-router-01. suricata-update reads this file at each
# rule refresh and writes /etc/suricata/threshold.config, which Suricata
# loads: a `suppress re:"<regex>", ...` line becomes one suppression for every
# enabled rule whose text matches, other lines are copied as they are. Edit
# this file, not threshold.config.
#
# jd-torrent-01 has no line here: Suricata does not see that host (the set
# suricata_exempt in nftables.conf).
#
# "Executable from a host with no name": Windows Update gives the two Windows
# servers their files that way.
suppress gen_id 1, sig_id 2021076, track by_either, ip [10.0.50.200,10.0.50.201]
#
# "Potential SSH scan outbound" fires at 5 new SSH connections in 120 s from
# one host. The jump host makes more than that when it fetches its git
# repositories (2,429 alerts in the 10 days, all to one git service). A
# threshold for one rule in this file replaces the threshold in the rule. A
# real scan makes hundreds of connections and still fires.
threshold gen_id 1, sig_id 2003068, type threshold, track by_src, count 30, seconds 120
