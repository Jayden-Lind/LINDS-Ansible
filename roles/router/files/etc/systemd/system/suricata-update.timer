# Managed by LINDS-Ansible (roles/router). Daily: the rule sources
# (etc/suricata/update.yaml) and the list of malware and phishing names
# change each day. The time is after dns-blocklist-update.timer (04:40 to
# 04:55), which fetches that list.
[Unit]
Description=Daily Suricata rule refresh

[Timer]
OnCalendar=*-*-* 05:15:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
