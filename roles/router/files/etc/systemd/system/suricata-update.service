# Managed by LINDS-Ansible (roles/router). Refresh the rule sources in
# /etc/suricata/update.yaml (honouring /etc/suricata/disable.conf) and
# reload the ruleset in place; a daemon
# restart would re-read ~50k rules with the IDS blind for ~20s.
[Unit]
Description=Refresh Suricata rules and reload them
After=network-online.target

[Service]
Type=oneshot
# The site's alert suppressions (threshold.in, from the role) become
# threshold.config here, matched against the new rules.
ExecStart=/usr/bin/suricata-update --no-reload --threshold-in /etc/suricata/threshold.in --threshold-out /etc/suricata/threshold.config
# A drop rule with `noalert` would drop traffic and log nothing: see
# /etc/suricata/drop.conf. Only a router where Suricata blocks has drop rules.
ExecStart=/usr/bin/sed -i -E "/[; ]noalert;/ s/^drop /alert /" /var/lib/suricata/rules/suricata.rules
ExecStart=-/usr/bin/suricatasc -c ruleset-reload-nonblocking
