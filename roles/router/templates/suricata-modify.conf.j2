# Managed by LINDS-Ansible: roles/router/templates/suricata-modify.conf.j2.
# suricata-update reads this file at each rule refresh and changes the text
# of the rules that match. One line: modifysid MATCH "FROM" | "TO". The line
# is split like a shell command: MATCH must have no space and no backslash.
{% if router_ips | bool %}
#
# This router's Suricata blocks. The address lists have "one alert an hour
# for each source" in each rule. That limits the alerts, not the drops: a
# block would show once an hour. Without it, each blocked connection is in
# the log and on the dashboard.
modifysid re:msg:.ET.(DROP|CINS|COMPROMISED). " *threshold:[^;]*;" | ""
{% endif %}
