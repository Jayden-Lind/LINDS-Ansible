# Managed by LINDS-Ansible: roles/proxmox/files/60-ioscheduler.rules.
# The I/O scheduler for each type of disk.
#
# Do not set queue/nr_requests here. With no scheduler, the queue is as deep
# as the controller tag set (1016 on the Adaptec), and the kernel refuses a
# higher value.

# SSDs (SATA and SAS) get no scheduler.
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"

# HDDs keep mq-deadline.
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="mq-deadline"

# NVMe disks get no scheduler.
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
